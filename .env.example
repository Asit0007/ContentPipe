# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- LLM provider chain (server/llm/) ---
# Text generation tries these in order and falls through on quota / overload / bad output, with
# Gemini last. A provider with no key is simply skipped. Grok is xAI's (XAI_API_KEY); Groq is a
# different company. Run `npm run llm:check` after editing: it verifies keys and model ids live.
#   DeepSeek, Grok (xAI)              pay-per-token
#   Groq, Cerebras, OpenRouter, Mistral   free tiers with rate limits (Mistral's requires opting
#                                     into training on your prompts)
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Optional overrides — model ids drift, so trust `npm run llm:check` over the defaults:
# LLM_PROVIDER_ORDER=deepseek,xai,groq,cerebras,openrouter,mistral,gemini
# DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-flash      (same pattern: XAI_MODELS, GROQ_MODELS, ...)
# DEEPSEEK_MAX_TOKENS=16000                            (same pattern per provider)
# LLM_TIMEOUT_MS=120000

# NOTEBOOKLM_API_KEY: Optional dedicated API key for Google NotebookLM services.
# Falls back automatically to GEMINI_API_KEY if not explicitly specified.
NOTEBOOKLM_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HOST: interface the server binds to. Defaults to 127.0.0.1 (this machine only) because the
# endpoints are unauthenticated and spend your Gemini quota. Set HOST=0.0.0.0 to expose it
# (Cloud Run / AI Studio), and only behind something that authenticates callers.
HOST=127.0.0.1

# --- Firebase web config ---
# Client-side values used by src/utils/googleWorkspace.ts for Google Workspace
# export (Docs/Sheets/Drive) via Firebase Auth. They are bundled into the browser
# build, so they are not secrets — but keep real values out of source control.
# Find them in Firebase Console > Project settings > Your apps > Web app.
#
# The VITE_ prefix means Vite inlines these into dist/, verbatim. That is by
# design for a Firebase web config, but it does mean the key is readable by
# anyone who loads a deployed build, so the restrictions are the only control:
#
#   API restrictions      Google Cloud Console > APIs & Services > Credentials.
#                         VERIFIED 2026-09-20 on the current key: calls to
#                         generativelanguage.googleapis.com come back 403
#                         "Requests to this API ... are blocked". That is the one
#                         that matters — an unrestricted key in a public bundle
#                         is someone else's Gemini bill. Re-check after any key
#                         rotation; a new key starts unrestricted.
#   Authorized domains    Firebase Console > Authentication > Settings. This, not
#                         an HTTP-referrer restriction, is what stops a sign-in
#                         being completed from someone else's page. The key
#                         answers identitytoolkit from any origin by design.
#
# Keep them out of git regardless: firebase-applet-config.json (which AI Studio
# writes with real values) and .env* are both gitignored, and the built dist/ is
# too — check that before changing .gitignore.
VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="MY_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID=""
