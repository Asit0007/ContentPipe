<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly tick of the Wan 2.2 free-quota measurement (scripts/wan-measure.ts). Install:
    cp deploy/com.asitminz.wanmeasure.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.asitminz.wanmeasure.plist
  Remove (the script also unloads itself when both phases are done):
    launchctl bootout gui/$(id -u)/com.asitminz.wanmeasure
  A tick costs nothing while the Space refuses; the first success opens the 24 h window and the job then runs until
  the wall. It is skipped while the Mac is asleep, which only delays it. Results: renders/wan-measure/summary.md.
  The paths below are this machine's; edit them elsewhere.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asitminz.wanmeasure</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>node_modules/.bin/tsx</string>
        <string>scripts/wan-measure.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/apple/Developer/My VSC projects/My Persona/ContentPipe</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/apple/Developer/My VSC projects/My Persona/ContentPipe/renders/wan-measure/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/apple/Developer/My VSC projects/My Persona/ContentPipe/renders/wan-measure/launchd.err.log</string>
</dict>
</plist>
