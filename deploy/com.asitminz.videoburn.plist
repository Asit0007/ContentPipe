<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly tick of the daily video burn (scripts/video-burn.ts): spends each free Hugging Face ZeroGPU window on AI
  footage across the Wan / MiniMax / LTX Spaces. Install:
    cp deploy/com.asitminz.videoburn.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.asitminz.videoburn.plist
  Remove:
    launchctl bootout gui/$(id -u)/com.asitminz.videoburn
  A tick costs nothing while the Spaces refuse; a pool that has used its window sleeps a few hours. It is skipped
  while the Mac is asleep, which only delays it. Results: renders/video-burn/summary.md. Paths are this machine's.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.asitminz.videoburn</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>node_modules/.bin/tsx</string>
        <string>scripts/video-burn.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/apple/Developer/My VSC projects/My Persona/ContentPipe</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/apple/Developer/My VSC projects/My Persona/ContentPipe/renders/video-burn/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/apple/Developer/My VSC projects/My Persona/ContentPipe/renders/video-burn/launchd.err.log</string>
</dict>
</plist>
