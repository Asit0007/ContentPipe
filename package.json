{
  "name": "contentpipe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "LLM_PROVIDER_ORDER=gemini LLM_MODEL_ORDER= GEMINI_RPM_PACING=off MODEL_USAGE_LOG=off tsx --test server/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=1 e2e/*.e2e.test.ts",
    "render:fixture": "tsx scripts/render-fixture.ts",
    "story:start": "tsx scripts/story-start.ts",
    "story:check": "node scripts/story-start.stub.mjs & STUB=$!; sleep 1; CONTENTPIPE_BASE_URL=http://127.0.0.1:3199 STORY_HEALTH_WAIT_SEC=10 tsx scripts/story-start.ts --story scripts/story-check-fixture.json --force; RC=$?; kill $STUB 2>/dev/null; exit $RC",
    "llm:check": "tsx scripts/llm-check.ts",
    "brief:page": "tsx scripts/brief-page.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
